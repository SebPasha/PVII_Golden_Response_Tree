# Copy to workflow/.env (gitignored) and fill in. The same keys PV2 uses, so PV2's
# workflow/.env can be copied as it is; its Supabase keys are ignored here.

# the Azure OpenAI endpoint and its key
OPENAI_BASE_URL=
AZURE_API_KEY=

# models: small for per-paragraph work (E), large for whole-document and tree work (C, F, M)
OPENAI_MODEL=
OPENAI_MODEL_ALL_AT_ONCE=

# Document Intelligence, the PDF parser (not called for a document PV2 already parsed)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# where the source library is: the folder holding sources/<slug>/... (PV2/data on Sebastian's Mac)
PVII_SOURCES_ROOT=

# PV2's parse cache, read and never written (PV2/data/cache), so no parse is paid for twice
PVII_PARSE_CACHE_FALLBACK=

# caps for one run (defaults 25 and 50000)
PVII_MAX_COST_USD=
PVII_MAX_CALLS=
