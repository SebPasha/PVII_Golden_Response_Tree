# Copy to workflow/.env (gitignored) and fill in. The same keys PV2 uses, so PV2's
# workflow/.env can be copied as it is; its Supabase keys are ignored here.

# the Azure OpenAI endpoint and its key
OPENAI_BASE_URL=
AZURE_API_KEY=

# models: small for per-paragraph work (E), large for whole-document and tree work (C, F, M)
OPENAI_MODEL=
OPENAI_MODEL_ALL_AT_ONCE=

# Document Intelligence, the PDF parser (not called for a document PV2 already parsed)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# where the source library is: the folder holding sources/<slug>/... (PV2/data on Sebastian's Mac)
PVII_SOURCES_ROOT=

# PV2's parse cache, read and never written (PV2/data/cache), so no parse is paid for twice
PVII_PARSE_CACHE_FALLBACK=

# caps for one run (defaults 25 and 50000)
PVII_MAX_COST_USD=
PVII_MAX_CALLS=

# ---- optional: leave blank for the defaults ----
# where configs, the tree and run outputs live (defaults: workflow/configs, tree/v1, data/)
PVII_CONFIGS=
PVII_TREE=
PVII_DATA=
# the response cache (default data/cache)
PVII_CACHE_DIR=
# 1 = answer only from the cache and never spend; a cache miss stops the run
PVII_OFFLINE=
# parallel model calls (0 = the default) and the time budget per step, in seconds (default 300)
PVII_CONCURRENCY=
PVII_STAGE_TIME_BUDGET=
# Document Intelligence pricing per page (default 0.01) and how long PDFs are split
PVII_DOCINT_PAGE_RATE=
PVII_DOCINT_PAGES_PER_SLICE=
PVII_DOCINT_SLICE_BYTES=
# copy each cache entry used here, to build a replay corpus
PVII_RECORD_DIR=
